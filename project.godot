; Engine configuration file.
config_version=5

[application]

config/name="Ambivironnement"
config/description="Ambisonic spatialisation tool designed for Cagire (JACK audio engine + Godot interface)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=false
run/max_fps=60

[autoload]

Session="*res://scripts/session.gd"
Link="*res://scripts/engine_link.gd"
Mirror="*res://scripts/mirror.gd"
Presets="*res://scripts/presets.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/resizable=true
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
